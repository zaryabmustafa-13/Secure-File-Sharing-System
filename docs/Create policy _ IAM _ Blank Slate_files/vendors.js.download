rArnRequired:()=>Apt("Enter a cluster ARN."),warningClusterArnMalformed:()=>Apt("This doesn't look like a valid EKS cluster ARN. An invalid ARN will leave agents or workloads in that cluster without an identity."),errorClusterArnDuplicate:()=>Apt("This cluster is already listed."),warningClusterArnsDrift:()=>Apt("This policy's cluster ARNs don't match the clusters you entered. Changing the clusters won't update this policy. Continue only if that's intended."),errorTooFewClusters:()=>Apt("Add at least 2 clusters."),attestationPolicyNote:e=>M(Ept,{components:{policyLink:e},children:"These clusters set the template's <policyLink>attestation policy</policyLink>."}),whatGetsCreatedHeader:()=>Apt("What gets created"),whatGetsCreatedDescription:()=>Apt("Creating this provider sets up these 2 resources."),providerCard:()=>Apt("Provider"),templateCard:()=>Apt("Template"),newBadge:()=>Apt("New"),templateNameConstraint:()=>Apt("Can't be changed later."),schemeFixedNote:()=>Apt("Required for service mesh providers."),scopeFixedNote:()=>Apt("Required for service mesh providers. A service mesh provider is scoped to the account that runs the EKS cluster."),trustDomainDescription:()=>Apt("Defaults to {provider name}.{account ID}.aws.internal. This must match the trust domain set in your service mesh, or the mesh rejects the identities."),useCaseLabel:()=>Apt("Use case"),useCaseValue:e=>Apt("{{label}} (service mesh)",{label:e}),identityPathLabel:()=>Apt("Identity path"),attestationPolicyLabel:()=>Apt("Attestation policy"),attestationPolicyDescription:()=>Apt("The attestation policy controls how identities are issued by this provider. An agent or workload must meet every condition, such as its type, details, and where it runs, as vouched for by the service that hosts it. Generated from the EKS clusters above. Can be edited later."),editAttestationPolicyAriaLabel:()=>Apt("Edit attestation policy"),errorClusterArnConditionRequired:e=>Apt("Add an {{conditionKey}} condition, so only agents or workloads in these clusters get an identity.",{conditionKey:e}),policySummaryIntro:()=>Apt("Agents and workloads in these EKS clusters can get an identity from this provider, when all of these are true:"),operatorEquals:()=>Apt("equals")},providerIdentitySummary:{title:e=>Apt("Settings from your provider {{providerName}}",{providerName:e}),schemeCaption:()=>Apt("scheme"),trustDomainCaption:()=>Apt("trust domain"),pathFromTemplatesCaption:()=>Apt("path from templates"),schemeLabel:()=>Apt("Scheme"),schemeNone:()=>Apt("None"),schemeNoneFormat:()=>Apt("None – names are defined by templates"),schemeTooltip:()=>Apt("Scheme sets the format this provider uses to name identities."),trustDomainLabel:()=>Apt("Trust domain"),trustDomainTooltip:()=>Apt("Trust domain is the root of trust for the SPIFFE naming scheme. It is a logical name that follows DNS naming style, for example prod.acme.com, but does not need to match a real DNS record."),scopeTooltip:()=>Apt("Scope sets which accounts are allowed to use this provider."),scopeOrganizationDescription:e=>Apt("Available to every account in your organization ({{organizationId}})",{organizationId:e}),scopeAccountDescription:e=>Apt("Available to this account ({{accountId}})",{accountId:e})},templateCard:{header:e=>Apt("{{label}} template",{label:e}),headerWithIndex:(e,t)=>Apt("{{label}} template {{index}}",{label:e,index:t}),nameConstraint:()=>Apt("Up to 128 characters. Use alphanumeric and '-_' characters. Must be unique per provider."),namePlaceholder:()=>Apt("Enter a name"),errorNameTooLong:()=>Apt("Template name must be 128 characters or less."),errorNameInvalidCharacters:()=>Apt("Invalid template name. Use alphanumeric and '-_' characters."),errorNameDuplicate:()=>Apt("A template with this name already exists."),identityPathLabel:()=>Apt("Identity path"),identityPathDescription:()=>Apt("Set the unique path pattern that every identity generated by this template follows. Cannot be changed later."),pathTooltip:()=>Apt("Path is the unique part of each identity's name. It is filled in at runtime from the facts an agent or workload proves."),attestationLabel:()=>Apt("Attestation policy"),attestationPolicyDescription:()=>Apt("The attestation policy controls how identities are issued by this provider. An agent or workload must meet every condition, such as its type, details, and where it runs, as vouched for by the service that hosts it. Can be edited later."),attestationDescriptionOrg:e=>Apt("Agents and workloads running in your organization can use identities generated by this template using information verified by {{workloadLabel}}.",{workloadLabel:e}),attestationDescriptionAccount:e=>Apt("Agents and workloads running in this account can use identities generated by this template using information verified by {{workloadLabel}}.",{workloadLabel:e}),attestationTooltip:()=>Apt("The attestation policy is the set of facts an agent or workload must prove before this provider issues it an identity. The compute platform vouches for them, so an agent or workload can't claim an identity that isn't its own."),pathPrefixLabel:()=>Apt("Path prefix"),pathPrefixDescription:()=>Apt("Define an optional path prefix for identities under this template. Lets you filter by prefix when authoring IAM permissions."),pathPrefixPlaceholder:()=>Apt("Enter prefix"),pathPrefixConstraint:()=>Apt("Letters, digits, . - _ with a single / between parts. No / at the start or end. Cannot be changed later."),pathPrefixDescriptionPolicy:()=>Apt("Define an optional prefix for identities under this template. You can filter by this prefix when authoring IAM permissions. The path prefixes this account can use are set by the provider's policy, for example your account ID, and they are checked when you choose Create. If you're not sure which are permitted, ask your organization administrator."),errorPathPrefixDenied:e=>Apt("This provider's policy doesn't allow this path prefix \"{{pathPrefix}}\" for your account. Ask your organizat